# Optional OpenScholar bridge. Must point to a separately deployed wrapper.
YIN_OPENSCHOLAR_BRIDGE_URL=

# Optional OpenAI-compatible chat-completions endpoint for claim auditing.
# Set all three values to enable semantic auditing; never commit real API keys.
YIN_LLM_BASE_URL=https://api.example.com/v1
YIN_LLM_API_KEY=
YIN_LLM_MODEL=
YIN_LLM_TIMEOUT=60

# SQLite path; defaults to ./yin.sqlite3 in the project directory.
YIN_DB_PATH=./yin.sqlite3

# Streamlit UI API target.
YIN_API_URL=http://127.0.0.1:8000
